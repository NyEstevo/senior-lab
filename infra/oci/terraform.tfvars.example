# Copie para terraform.tfvars e preencha com valores reais. Nunca versione o
# terraform.tfvars preenchido (segredos ficam aqui em texto plano só localmente,
# antes de irem para o OCI Vault).

tenancy_ocid      = "ocid1.tenancy.oc1..exemplo"
user_ocid         = "ocid1.user.oc1..exemplo"
fingerprint       = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path  = "~/.oci/oci_api_key.pem"
private_key_password = "" # deixe vazio se a chave não tiver passphrase
region            = "sa-saopaulo-1"
compartment_ocid  = "ocid1.compartment.oc1..exemplo"

environment = "demo"
domain_name = "seniorlab.exemplo.com"

anthropic_api_key  = "sk-ant-xxxxxxxxxxxxxxxxxxxx"
anthropic_model    = "claude-sonnet-4-5-20251001"
postgres_user      = "seniorlab"
postgres_password  = "troque-esta-senha"
postgres_db        = "seniorlab"

backend_image  = "gru.ocir.io/<namespace>/seniorlab-backend:latest"
frontend_image = "gru.ocir.io/<namespace>/seniorlab-frontend:latest"
